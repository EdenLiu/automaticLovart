{
  "lovartUrl": "https://www.lovart.ai/",
  "storageStatePath": "./.auth/lovart.storage.json",
  "tasksPath": "./prompts.json",
  "outputDir": "./picture_lovart",
  "maxRounds": 6,
  "headless": true,
  "browserChannel": "chrome",
  "realChromeDebugPort": 9222,
  "realChromeUserDataDir": "./.auth/real-chrome-profile",
  "navigationTimeoutMs": 90000,
  "promptSubmitTimeoutMs": 45000,
  "generationWaitMs": 600000,
  "pollIntervalMs": 5000,
  "minImageBytes": 4096,
  "minImageEdgePx": 160,
  "selectors": {
    "entryButtons": [
      "text=/Get started/i",
      "text=/Get started for free/i",
      "text=/Design now/i",
      "text=/Start creating/i",
      "text=/Create/i"
    ],
    "promptInputs": [
      "textarea",
      "[contenteditable='true']",
      "[role='textbox']",
      "input[type='text']"
    ],
    "submitButtons": [
      "button:has-text('Send')",
      "button:has-text('Submit')",
      "button:has-text('Generate')",
      "button:has-text('Create')",
      "button[aria-label*='Send' i]",
      "button[aria-label*='Generate' i]"
    ],
    "assistantMessages": [
      "[data-testid*='message']",
      "[class*='message']",
      "[class*='chat']",
      "main"
    ]
  },
  "followUpPrompt": "Please continue without asking for more confirmation. Generate the final image for the original request now, and make the image available for download."
}
